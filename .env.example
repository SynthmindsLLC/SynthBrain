# SynthBrain — environment variables
# Copy this file to .env.local (gitignored) and fill in values.
# NEVER commit real secrets. Vercel + GitHub Actions secrets carry prod values.

# ── Mem.ai (canonical knowledge store; accessed via mem MCP server in .mcp.json)
MEM_API_KEY=

# ── Fieldy AI (wearable transcription — Phase A pilot)
# Get from https://app.fieldy.ai → Settings → API Keys; key starts with sk-f-
FIELDY_API_KEY=
FIELDY_API_BASE=https://api.fieldy.ai/api/public/v2
# If api.fieldy.ai/mcp is a valid MCP endpoint, set to enable Path-1 MCP transport
FIELDY_MCP_URL=https://api.fieldy.ai/mcp
# HMAC secret for webhook signature verification (Fieldy provides on webhook creation)
FIELDY_WEBHOOK_SECRET=

# ── Google OAuth (Calendar, Drive, Gmail connectors — Phase B)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── Granola (meeting AI — Phase B)
GRANOLA_API_KEY=

# ── OpenAI (tag classifier — Phase C)
OPENAI_API_KEY=

# ── Python brain (second-brain FastAPI surface — apps/web talks to it via server-side proxies)
# Base URL of the running brain API (e.g. `uvicorn brain.api:app --port 8088`).
# apps/web defaults to http://127.0.0.1:8088 when unset.
BRAIN_URL=http://127.0.0.1:8088
# Set to 1 to make apps/web prefer the brain graph even when BRAIN_URL is unset.
USE_BRAIN=
# Optional shared secret; must match the token the brain API is started with.
# Sent server-side only (Authorization: Bearer …) — never exposed to the client.
BRAIN_BEARER_TOKEN=

# ── Public-facing URL of the deployed PWA
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Universal intake (see docs/setup/feed-the-brain.md)
# BRAIN_INBOX_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/BrainInbox
# AGENTMAIL_API_KEY=            # AgentMail console -> API keys; enables email-forward intake

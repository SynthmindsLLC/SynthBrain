# Copy to .env.local (gitignored) and fill in real values.

# Fieldy public API key (Public API section of Fieldy Developer Settings).
# Used by brain.adapters.fieldy_adapter for transcript ingest.
FIELDY_API_KEY=sk-f-...
FIELDY_API_BASE=https://api.fieldy.ai/api/public/v2
FIELDY_MCP_URL=https://api.fieldy.ai/mcp

# Google OAuth (same client used by apps/connectors/drive — add calendar.readonly
# + contacts.readonly scopes for the live entity sync adapters).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Mem API key — only needed if you re-enable the MemApiAdapter (incremental
# Mem sync). Pure markdown export ingest needs nothing.
MEM_API_KEY=

# OpenAI key — only needed when --embedder openai.
OPENAI_API_KEY=

# Anthropic key — only needed when:
#   - `ingest --llm-classifier` (pass-2 layer classifier)
#   - dossier() default synthesis hook
#   - email triage LLM tiebreaker stage
ANTHROPIC_API_KEY=

# IMAP (iCloud Mail / Fastmail / generic). Use an APP-SPECIFIC PASSWORD
# (Apple ID -> Sign-In and Security -> App-Specific Passwords). NEVER your
# real iCloud password. The adapter never echoes these.
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Comma-separated "your own" domains -- senders/recipients matching auto-pass
# the email-filter (treated as work mail).
IMAP_OWN_DOMAINS=synthminds.ai

# iMessage (macOS Messages.app chat.db). Optional override; defaults to
# ~/Library/Messages/chat.db. Grant Full Disk Access to your terminal in
# System Settings -> Privacy & Security.
# IMESSAGE_DB_PATH=

# iCloud Notes (macOS NoteStore.sqlite). Optional override.
# ICLOUD_NOTES_DB_PATH=

# GitHub PAT for the github adapter. Fine-grained token recommended;
# permissions: Issues: Read, Pull requests: Read, Contents: Read.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_USERNAME=

# Microsoft 365 / Outlook (Graph API). Skip if you don't use M365.
# Register an app at portal.azure.com -> Azure AD -> App registrations,
# add scopes Mail.Read, Calendars.Read, User.Read, offline_access.
# Mint a refresh token via the OAuth2 device-code or auth-code flow.
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_REFRESH_TOKEN=
M365_OWN_DOMAINS=synthminds.ai

# Slack user token (xoxp-...) for the slack adapter. Create at
# api.slack.com/apps -> create app -> add scopes:
#   channels:history groups:history im:history mpim:history
#   channels:read groups:read im:read mpim:read users:read
# Install to your workspace and copy the User OAuth Token.
SLACK_USER_TOKEN=

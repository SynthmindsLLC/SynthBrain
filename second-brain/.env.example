# Copy to .env.local (gitignored) and fill in real values.

# Fieldy public API key (Public API section of Fieldy Developer Settings).
# Used by brain.adapters.fieldy_adapter for transcript ingest.
FIELDY_API_KEY=sk-f-...
FIELDY_API_BASE=https://api.fieldy.ai/api/public/v2
FIELDY_MCP_URL=https://api.fieldy.ai/mcp

# Google OAuth (same client used by apps/connectors/drive — add calendar.readonly
# + contacts.readonly scopes for the live entity sync adapters).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Mem API key — only needed if you re-enable the MemApiAdapter (incremental
# Mem sync). Pure markdown export ingest needs nothing.
MEM_API_KEY=

# OpenAI key — only needed when --embedder openai.
OPENAI_API_KEY=
